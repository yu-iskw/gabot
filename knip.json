{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".trunk/**"],
  "ignoreBinaries": ["grype", "docker"],
  "ignoreDependencies": ["@fontsource-variable/inter", "tailwindcss"],
  "ignoreWorkspaces": ["e2e"],
  "workspaces": {
    ".": {
      "entry": ["stylelint.config.mjs", "tests/**/*.ts"],
      "project": [
        "**/*.{js,cjs,mjs,ts,cts,mts}",
        "!packages/**",
        "!.trunk/**",
        "!node_modules/**",
        "!e2e/**"
      ]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/migrate.ts", "src/main.tsx", "server/serve.ts"],
      "project": ["src/**/*.{ts,tsx}", "server/**/*.ts"]
    }
  }
}
