{
  "name": "gabot",
  "version": "1.0.0",
  "private": true,
  "description": "Google Cloud coworker platform: governed agents, computers, and MCP without CopilotKit.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "",
  "scripts": {
    "build": "pnpm --recursive build",
    "trunk": "trunk",
    "format": "pnpm format:trunk",
    "format:all": "pnpm format:trunk-all",
    "format:eslint": "eslint . --fix",
    "format:prettier": "prettier --write .",
    "format:trunk": "trunk fmt",
    "format:trunk-all": "trunk fmt --all",
    "lint": "pnpm lint:trunk",
    "lint:all": "pnpm lint:trunk-all && pnpm security:grype",
    "lint:eslint": "eslint .",
    "lint:security": "trunk check --all --scope security",
    "lint:trunk": "trunk check -y",
    "lint:trunk-all": "trunk check --all -y",
    "security:grype": "grype .",
    "knip": "knip",
    "codeql:local": "bash dev/codeql.sh",
    "test": "pnpm --filter @gabot/common build && vitest run",
    "test:e2e": "pnpm --filter @gabot/e2e test",
    "coverage": "pnpm --filter @gabot/common build && vitest run --coverage",
    "coverage:watch": "vitest --coverage",
    "compose:up": "docker compose -f compose/docker-compose.yml up -d --wait",
    "compose:down": "docker compose -f compose/docker-compose.yml down --remove-orphans"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@trunkio/launcher": "^1.3.4",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "knip": "6.32.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.0.5",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.0.5"
  }
}
