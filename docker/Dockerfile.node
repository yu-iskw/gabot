# Node runtime for control-plane and coworker services.
# Cloud Run mapping (docs/deploy.md):
#   api  — plain service, never --functional-type
#   agent — --functional-type=agent --identity-type=agent-identity
#   jobs — Cloud Run job
#   mcp-mock — --functional-type=mcp-server
FROM node:24.13.0-bookworm-slim
RUN corepack enable
WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY e2e ./e2e
COPY examples ./examples
RUN pnpm install --frozen-lockfile \
  && pnpm --recursive build \
  && chown -R node:node /app
ARG PACKAGE=api
ENV PACKAGE=${PACKAGE}
WORKDIR /app/packages/${PACKAGE}
USER node
EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=5s --retries=5 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||'3001')+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/index.js"]
