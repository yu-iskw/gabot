FROM node:24.13.0-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && npm install -g firebase-tools@14.15.1 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /firebase
COPY compose/firebase /firebase
RUN chown -R node:node /firebase
USER node
EXPOSE 9099
HEALTHCHECK --interval=5s --timeout=5s --retries=20 CMD node -e "fetch('http://127.0.0.1:9099').then(()=>process.exit(0),()=>process.exit(1))"
# Auth emulator must listen on 0.0.0.0:9099. The API uses FIREBASE_AUTH_EMULATOR_HOST=auth:9099;
# the browser uses localhost:9099 on the published loopback port.
CMD ["firebase", "emulators:start", "--only", "auth", "--project", "demo-gabot"]
