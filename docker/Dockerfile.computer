# Playwright Chromium computer.
# Production: Cloud Run instance + --sandbox-launcher. Agent Platform flags cannot be set on instances.
FROM node:24.13.0-bookworm-slim AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY e2e ./e2e
COPY examples ./examples
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @gabot/computer... build

FROM mcr.microsoft.com/playwright:v1.55.1-noble
WORKDIR /app
COPY --from=build --chown=pwuser:pwuser /app /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app/packages/computer
USER pwuser
EXPOSE 4100
HEALTHCHECK --interval=10s --timeout=5s --retries=5 CMD node -e "fetch('http://127.0.0.1:4100/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/index.js"]
